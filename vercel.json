{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.(avif|css|ico|jpg|js|png|svg|webp|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/identify.js": {
      "maxDuration": 60
    },
    "api/ebay.js": {
      "maxDuration": 20
    },
    "api/tcgplayer.js": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/api/admin-subscribers",
      "destination": "/api/admin-signups"
    },
    {
      "source": "/api/admin-profiles",
      "destination": "/api/admin-signups?type=profiles"
    },
    {
      "source": "/api/admin-entries",
      "destination": "/api/admin-signups?type=entries"
    }
  ]
}
